{
  "name": "CommitteeMember",
  "type": "object",
  "properties": {
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "full_name_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "chair",
        "vice_chair",
        "secretary",
        "member",
        "observer",
        "advisor"
      ],
      "default": "member"
    },
    "authority_level": {
      "type": "string",
      "title": "Authority Level",
      "enum": [
        "decision",
        "approval",
        "execution",
        "oversight",
        "escalation",
        "advisory"
      ],
      "default": "decision"
    },
    "institution_name": {
      "type": "string",
      "title": "Representing Institution"
    },
    "term_start": {
      "type": "string",
      "title": "Term Start",
      "format": "date"
    },
    "term_end": {
      "type": "string",
      "title": "Term End",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "recused",
        "resigned"
      ],
      "default": "active"
    }
  },
  "required": [
    "committee_id",
    "full_name",
    "role",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}