{
  "name": "QuorumRule",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "rule_type": {
      "type": "string",
      "title": "Rule Type",
      "enum": [
        "fixed_count",
        "percentage",
        "majority_of_voting",
        "custom"
      ],
      "default": "fixed_count"
    },
    "quorum_count": {
      "type": "number",
      "title": "Quorum Count (fixed)",
      "default": 3
    },
    "quorum_percentage": {
      "type": "number",
      "title": "Quorum Percentage",
      "minimum": 0,
      "maximum": 100
    },
    "includes_chair": {
      "type": "boolean",
      "title": "Chair Counts Toward Quorum",
      "default": true
    },
    "excludes_observers": {
      "type": "boolean",
      "title": "Observers Excluded",
      "default": true
    },
    "excludes_recused": {
      "type": "boolean",
      "title": "Recused Members Excluded",
      "default": true
    },
    "alternate_counts_when_activated": {
      "type": "boolean",
      "title": "Activated Alternates Count",
      "default": true
    },
    "effective_date": {
      "type": "string",
      "title": "Effective Date",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "superseded",
        "draft"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "rule_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}