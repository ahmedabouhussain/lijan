{
  "name": "DocumentVersion",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "file_url": {
      "type": "string",
      "title": "File URL",
      "format": "uri"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_size_bytes": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash (SHA-256)"
    },
    "change_summary": {
      "type": "string",
      "title": "Change Summary"
    },
    "change_summary_ar": {
      "type": "string",
      "title": "\u0645\u0644\u062e\u0635 \u0627\u0644\u062a\u063a\u064a\u064a\u0631"
    },
    "uploaded_by_name": {
      "type": "string",
      "title": "Uploaded By"
    },
    "uploaded_by_user_id": {
      "type": "string",
      "title": "Uploaded By User ID"
    },
    "is_frozen": {
      "type": "boolean",
      "title": "Frozen (immutable)",
      "default": false
    },
    "frozen_at": {
      "type": "string",
      "title": "Frozen At",
      "format": "date-time"
    },
    "uploaded_at": {
      "type": "string",
      "title": "Uploaded At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "current",
        "superseded",
        "frozen",
        "archived"
      ],
      "default": "current"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "document_id",
    "version_number",
    "file_url",
    "uploaded_at",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}