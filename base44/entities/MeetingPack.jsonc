{
  "name": "MeetingPack",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID"
    },
    "pack_number": {
      "type": "string",
      "title": "Pack Number"
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "title": {
      "type": "string",
      "title": "Pack Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062d\u0632\u0645\u0629"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "document_ids": {
      "type": "string",
      "title": "Document IDs (JSON array)"
    },
    "agenda_item_ids": {
      "type": "string",
      "title": "Agenda Item IDs (JSON array)"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash (frozen)"
    },
    "file_url": {
      "type": "string",
      "title": "Compiled Pack File URL",
      "format": "uri"
    },
    "published_by_name": {
      "type": "string",
      "title": "Published By"
    },
    "published_by_user_id": {
      "type": "string",
      "title": "Published By User ID"
    },
    "published_at": {
      "type": "string",
      "title": "Published At",
      "format": "date-time"
    },
    "superseded_by_version": {
      "type": "number",
      "title": "Superseded By Version"
    },
    "superseded_at": {
      "type": "string",
      "title": "Superseded At",
      "format": "date-time"
    },
    "acknowledged_by": {
      "type": "string",
      "title": "Acknowledged By (JSON array of user IDs)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "published",
        "superseded",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "meeting_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}