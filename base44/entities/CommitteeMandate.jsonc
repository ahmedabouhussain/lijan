{
  "name": "CommitteeMandate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "establishing_instrument": {
      "type": "string",
      "title": "Establishing Instrument"
    },
    "establishing_instrument_en": {
      "type": "string",
      "title": "Establishing Instrument (English)"
    },
    "official_reference": {
      "type": "string",
      "title": "Official Reference"
    },
    "official_reference_en": {
      "type": "string",
      "title": "Official Reference (English)"
    },
    "issuing_authority": {
      "type": "string",
      "title": "Issuing Authority"
    },
    "issuing_authority_en": {
      "type": "string",
      "title": "Issuing Authority (English)"
    },
    "mandate_text": {
      "type": "string",
      "title": "Mandate Text (English)"
    },
    "mandate_text_ar": {
      "type": "string",
      "title": "\u0646\u0635 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629"
    },
    "scope": {
      "type": "string",
      "title": "Scope"
    },
    "scope_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0646\u0637\u0627\u0642"
    },
    "powers": {
      "type": "string",
      "title": "Powers"
    },
    "powers_en": {
      "type": "string",
      "title": "Powers (English)"
    },
    "prohibited_matters": {
      "type": "string",
      "title": "Prohibited / Out-of-Scope Matters"
    },
    "prohibited_matters_en": {
      "type": "string",
      "title": "Prohibited / Out-of-Scope Matters (English)"
    },
    "deliverables": {
      "type": "string",
      "title": "Deliverables"
    },
    "deliverables_en": {
      "type": "string",
      "title": "Deliverables (English)"
    },
    "reporting_lines": {
      "type": "string",
      "title": "Reporting Lines"
    },
    "reporting_lines_en": {
      "type": "string",
      "title": "Reporting Lines (English)"
    },
    "effective_start": {
      "type": "string",
      "title": "Effective Start"
    },
    "effective_end": {
      "type": "string",
      "title": "Effective End"
    },
    "version": {
      "type": "number",
      "title": "Version"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}