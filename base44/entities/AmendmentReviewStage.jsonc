{
  "name": "AmendmentReviewStage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "amendment_id": {
      "type": "string",
      "title": "Amendment ID"
    },
    "stage": {
      "type": "string",
      "title": "Review Stage",
      "enum": [
        "secretary_review",
        "governance_review",
        "legal_review"
      ],
      "default": "secretary_review"
    },
    "stage_label": {
      "type": "string",
      "title": "Stage Label (display)"
    },
    "reviewer_name": {
      "type": "string",
      "title": "Reviewer Name"
    },
    "reviewer_user_id": {
      "type": "string",
      "title": "Reviewer User ID"
    },
    "verdict": {
      "type": "string",
      "title": "Verdict",
      "enum": [
        "approved",
        "approved_with_comments",
        "return_for_revision",
        "rejected"
      ],
      "default": "approved"
    },
    "comments": {
      "type": "string",
      "title": "Review Comments"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "completed",
        "returned",
        "skipped"
      ],
      "default": "pending"
    },
    "sequence_order": {
      "type": "number",
      "title": "Sequence Order",
      "default": 1
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "amendment_id",
    "stage",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}