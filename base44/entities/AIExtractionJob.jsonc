{
  "name": "AIExtractionJob",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "instrument_id": {
      "type": "string",
      "title": "Founding Instrument ID"
    },
    "instrument_version_id": {
      "type": "string",
      "title": "Instrument Version ID"
    },
    "job_type": {
      "type": "string",
      "title": "Job Type",
      "enum": [
        "charter_extraction",
        "field_extraction",
        "reconciliation",
        "classification"
      ],
      "default": "field_extraction"
    },
    "job_status": {
      "type": "string",
      "title": "Job Status",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "partial"
      ],
      "default": "queued"
    },
    "model_used": {
      "type": "string",
      "title": "Model Used"
    },
    "prompt_summary": {
      "type": "string",
      "title": "Prompt Summary"
    },
    "started_at": {
      "type": "string",
      "title": "Started At",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "title": "Duration (ms)"
    },
    "field_count": {
      "type": "number",
      "title": "Fields Extracted",
      "default": 0
    },
    "confirmed_count": {
      "type": "number",
      "title": "Fields Confirmed",
      "default": 0
    },
    "average_confidence": {
      "type": "number",
      "title": "Average Confidence (0-1)",
      "default": 0
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "triggered_by_user_id": {
      "type": "string",
      "title": "Triggered By User ID"
    },
    "triggered_by_name": {
      "type": "string",
      "title": "Triggered By Name"
    },
    "raw_output": {
      "type": "string",
      "title": "Raw AI Output (JSON)"
    }
  },
  "required": [
    "organization_id",
    "instrument_id",
    "job_type",
    "job_status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}