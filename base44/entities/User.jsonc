{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "governance_role": {
      "type": "string",
      "title": "Governance Role",
      "description": "The user's governance role \u2014 drives the role-based home experience",
      "enum": [
        "executive",
        "chair",
        "secretary",
        "member",
        "auditor"
      ],
      "default": "member"
    },
    "active_org_id": {
      "type": "string",
      "title": "Active Organization ID",
      "description": "Context only \u2014 not evidence of authorization. Server resolves entitlement from OrganizationMembership."
    },
    "active_committee_id": {
      "type": "string",
      "title": "Active Committee ID",
      "description": "Context only \u2014 not evidence of authorization."
    },
    "locale": {
      "type": "string",
      "title": "Interface Language",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar"
    },
    "display_name_ar": {
      "type": "string",
      "title": "Display Name (Arabic)"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL",
      "format": "uri",
      "description": "Profile picture URL"
    },
    "title": {
      "type": "string",
      "title": "Job Title",
      "description": "The user's professional title / position"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "signature_text": {
      "type": "string",
      "title": "Signature Text",
      "description": "Typed electronic signature (styled)"
    },
    "signature_image_url": {
      "type": "string",
      "title": "Signature Image URL",
      "format": "uri",
      "description": "Drawn electronic signature image"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}