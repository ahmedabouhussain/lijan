{
  "name": "Committee",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "title": "Institution ID (V1 legacy)"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID (V2)"
    },
    "mandate_id": {
      "type": "string",
      "title": "Committee Mandate ID (V2)"
    },
    "name_ar": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0644\u062c\u0646\u0629"
    },
    "name_en": {
      "type": "string",
      "title": "Committee Name (English)"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug (human-readable, not a security key)"
    },
    "public_id": {
      "type": "string",
      "title": "Public ID (immutable authoritative identity)"
    },
    "type": {
      "type": "string",
      "title": "Committee Type",
      "enum": [
        "permanent_council",
        "permanent_committee",
        "temporary_committee",
        "ministerial_committee",
        "national_committee",
        "task_force",
        "working_group",
        "advisory_committee",
        "special_committee",
        "joint_committee",
        "cross_institutional"
      ],
      "default": "permanent_committee"
    },
    "mandate": {
      "type": "string",
      "title": "Mandate / \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629"
    },
    "establishing_authority": {
      "type": "string",
      "title": "Establishing Authority"
    },
    "establishing_doc_type": {
      "type": "string",
      "title": "Establishing Document Type",
      "enum": [
        "decision",
        "circular",
        "decree",
        "resolution",
        "charter",
        "other"
      ],
      "default": "other"
    },
    "establishing_doc_reference": {
      "type": "string",
      "title": "Establishing Document Reference"
    },
    "establishing_doc_date": {
      "type": "string",
      "title": "Establishing Document Date",
      "format": "date"
    },
    "appointing_authority": {
      "type": "string",
      "title": "Appointing Authority (V2)"
    },
    "scope": {
      "type": "string",
      "title": "Scope & Responsibilities"
    },
    "term_start": {
      "type": "string",
      "title": "Term Start",
      "format": "date"
    },
    "term_end": {
      "type": "string",
      "title": "Term End",
      "format": "date"
    },
    "chair_name": {
      "type": "string",
      "title": "Chair Name"
    },
    "secretary_name": {
      "type": "string",
      "title": "Secretary Name"
    },
    "logo_url": {
      "type": "string",
      "title": "Committee Logo URL",
      "format": "uri"
    },
    "quorum_count": {
      "type": "number",
      "title": "Quorum Count",
      "default": 3
    },
    "voting_rule": {
      "type": "string",
      "title": "Voting Rule",
      "enum": [
        "simple_majority",
        "two_thirds",
        "unanimous",
        "chair_decides"
      ],
      "default": "simple_majority"
    },
    "meeting_cadence": {
      "type": "string",
      "title": "Meeting Cadence",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "quarterly",
        "ad_hoc"
      ],
      "default": "monthly"
    },
    "classification": {
      "type": "string",
      "title": "Classification",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "highly_restricted"
      ],
      "default": "internal"
    },
    "reporting_requirements": {
      "type": "string",
      "title": "Reporting Requirements"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "pending_activation",
        "active",
        "temporarily_suspended",
        "expiring_soon",
        "closing",
        "closed",
        "archived"
      ],
      "default": "draft"
    },
    "version": {
      "type": "number",
      "title": "Record Version",
      "default": 1
    },
    "governance_complete": {
      "type": "boolean",
      "title": "Governance Complete",
      "default": false
    },
    "audit_correlation_id": {
      "type": "string",
      "title": "Audit Correlation ID"
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_dataset": {
      "type": "string",
      "title": "Demo Dataset Key"
    }
  },
  "required": [
    "organization_id",
    "name_ar",
    "name_en",
    "type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}