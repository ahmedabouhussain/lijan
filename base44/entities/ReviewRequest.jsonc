{
  "name": "ReviewRequest",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "document_version_id": {
      "type": "string",
      "title": "Document Version ID"
    },
    "requested_by_name": {
      "type": "string",
      "title": "Requested By"
    },
    "requested_by_user_id": {
      "type": "string",
      "title": "Requested By User ID"
    },
    "reviewer_name": {
      "type": "string",
      "title": "Reviewer Name"
    },
    "reviewer_user_id": {
      "type": "string",
      "title": "Reviewer User ID"
    },
    "reviewer_role": {
      "type": "string",
      "title": "Reviewer Role (a request may be addressed to the seat a person holds)",
      "enum": [
        "chair",
        "vice_chair",
        "secretary"
      ]
    },
    "review_type": {
      "type": "string",
      "title": "Review Type",
      "enum": [
        "legal",
        "financial",
        "technical",
        "editorial",
        "classification",
        "other"
      ],
      "default": "other"
    },
    "instructions": {
      "type": "string",
      "title": "Review Instructions"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date",
      "format": "date"
    },
    "requested_at": {
      "type": "string",
      "title": "Requested At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "accepted",
        "in_review",
        "completed",
        "declined",
        "overdue"
      ],
      "default": "pending"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "document_id",
    "requested_by_name",
    "reviewer_name",
    "requested_at",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}