{
  "name": "MeetingMinutes",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "minutes_number": {
      "type": "string",
      "title": "Minutes Number"
    },
    "call_to_order": {
      "type": "string",
      "title": "Call to Order"
    },
    "adjournment": {
      "type": "string",
      "title": "Adjournment"
    },
    "present_count": {
      "type": "number",
      "title": "Present Count"
    },
    "absent_count": {
      "type": "number",
      "title": "Absent Count"
    },
    "apologies_count": {
      "type": "number",
      "title": "Apologies Count"
    },
    "quorum_met": {
      "type": "boolean",
      "title": "Quorum Met"
    },
    "previous_minutes_approved": {
      "type": "boolean",
      "title": "Previous Minutes Approved"
    },
    "body": {
      "type": "string",
      "title": "Minutes Body (Markdown)"
    },
    "body_en": {
      "type": "string",
      "title": "Minutes Body (English)"
    },
    "summary_ar": {
      "type": "string",
      "title": "\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u062d\u0636\u0631"
    },
    "summary_en": {
      "type": "string",
      "title": "Minutes Summary (English)"
    },
    "generated_by_ai": {
      "type": "boolean",
      "title": "AI Generated Draft"
    },
    "drafted_by_name": {
      "type": "string",
      "title": "Drafted By"
    },
    "drafted_by_name_en": {
      "type": "string",
      "title": "Drafted By (English)"
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By"
    },
    "reviewed_by_name_en": {
      "type": "string",
      "title": "Reviewed By (English)"
    },
    "approved_by_name": {
      "type": "string",
      "title": "Approved By (Chair)"
    },
    "approved_by_name_en": {
      "type": "string",
      "title": "Approved By (Chair, English)"
    },
    "approved_date": {
      "type": "string",
      "title": "Approval Date"
    },
    "issued_date": {
      "type": "string",
      "title": "Issued Date"
    },
    "next_meeting_date": {
      "type": "string",
      "title": "Next Meeting Date"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "meeting_id",
    "committee_id",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}