{
  "name": "RetentionRule",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "record_class": {
      "type": "string",
      "title": "\u0635\u0646\u0641 \u0627\u0644\u0645\u0648\u0627\u062f (The class of material \u2014 one rule per class per committee)",
      "enum": [
        "decision_package",
        "minutes",
        "action_evidence",
        "documents",
        "annotations"
      ]
    },
    "basis": {
      "type": "string",
      "title": "\u0623\u0633\u0627\u0633 \u0627\u0644\u0645\u062f\u0629: \u0645\u062f\u0629 \u0645\u062d\u062f\u062f\u0629 \u0623\u0648 \u0627\u062d\u062a\u0641\u0627\u0638 \u062f\u0627\u0626\u0645 \u2014 \u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 (A stated period, or permanence: the institution's own choice)",
      "enum": [
        "years",
        "permanent"
      ]
    },
    "retention_years": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u062f\u0629 \u0628\u0627\u0644\u0633\u0646\u0648\u0627\u062a (\u0645\u0637\u0644\u0648\u0628\u0629 \u0639\u0646\u062f \u0623\u0633\u0627\u0633 \u0627\u0644\u0633\u0646\u0648\u0627\u062a)"
    },
    "disposal_authority": {
      "type": "string",
      "title": "\u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0628\u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0639\u0646\u062f \u0627\u0646\u0642\u0636\u0627\u0621 \u0627\u0644\u0645\u062f\u0629 (The authority competent to decide the disposition)"
    },
    "disposal_route": {
      "type": "string",
      "title": "\u0637\u0631\u064a\u0642 \u0627\u0644\u0625\u062a\u0644\u0627\u0641 \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u2014 \u0625\u062c\u0631\u0627\u0621 \u0645\u0624\u0633\u0633\u064a \u0648\u062d\u062f\u0647\u060c \u0648\u0627\u0644\u0633\u062c\u0644 \u064a\u0628\u0642\u0649 (The only admitted route: an institutional review that keeps the record)",
      "enum": [
        "institutional_review_only"
      ],
      "default": "institutional_review_only"
    },
    "instrument_basis": {
      "type": "string",
      "title": "\u0646\u0635\u0651 \u0627\u0644\u0633\u0646\u062f \u0627\u0644\u0646\u0638\u0627\u0645\u064a \u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 (The instrument clause the schedule rests on \u2014 required)"
    },
    "policy_version": {
      "type": "string",
      "title": "Policy Revision Stated by the Institution"
    },
    "contract_version": {
      "type": "string",
      "title": "Retention Contract Version in Force"
    },
    "recorded_by_user_id": {
      "type": "string",
      "title": "Recorded By (user id)"
    },
    "recorded_by_name": {
      "type": "string",
      "title": "Recorded By (display only)"
    },
    "recorded_at": {
      "type": "string",
      "title": "Recorded At (server clock)",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629: \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u062a\u064f\u0633\u062a\u0628\u062f\u0644 \u0648\u0644\u0627 \u062a\u064f\u0639\u0627\u062f \u0643\u062a\u0627\u0628\u062a\u0647\u0627 (A superseded rule is preserved, never rewritten)",
      "enum": [
        "active",
        "superseded"
      ],
      "default": "active"
    },
    "data_origin": {
      "type": "string",
      "title": "Data Origin (internal provenance)",
      "enum": [
        "source_based",
        "synthetic_presentational",
        "operational"
      ],
      "default": "operational"
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_dataset": {
      "type": "string",
      "title": "Demo Dataset Key"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "record_class",
    "basis",
    "disposal_authority",
    "instrument_basis",
    "contract_version",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}