{
  "name": "RoleAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID (null = org-level role)"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_email": {
      "type": "string",
      "title": "User Email",
      "format": "email"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "role_key": {
      "type": "string",
      "title": "Role Key",
      "enum": [
        "org_owner",
        "org_admin",
        "chair",
        "vice_chair",
        "secretary",
        "member",
        "alternate",
        "observer",
        "advisor",
        "auditor",
        "action_owner",
        "legal_reviewer"
      ]
    },
    "effective_start": {
      "type": "string",
      "title": "Effective Start",
      "format": "date"
    },
    "effective_end": {
      "type": "string",
      "title": "Effective End",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "revoked_at": {
      "type": "string",
      "title": "Revoked At",
      "format": "date-time"
    },
    "delegation_id": {
      "type": "string",
      "title": "Originating Delegation ID"
    }
  },
  "required": [
    "organization_id",
    "user_id",
    "role_key",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}