{
  "name": "ExtractedInstrumentField",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "instrument_id": {
      "type": "string",
      "title": "Founding Instrument ID"
    },
    "extraction_job_id": {
      "type": "string",
      "title": "AI Extraction Job ID"
    },
    "field_key": {
      "type": "string",
      "title": "Field Key (e.g. title_ar, issue_date)"
    },
    "field_label": {
      "type": "string",
      "title": "Field Label (display)"
    },
    "field_label_ar": {
      "type": "string",
      "title": "Field Label (Arabic)"
    },
    "extracted_value": {
      "type": "string",
      "title": "Extracted Value"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence Score (0-1)",
      "default": 0
    },
    "source_snippet": {
      "type": "string",
      "title": "Source Snippet (text that justified extraction)"
    },
    "page_number": {
      "type": "number",
      "title": "Page Number"
    },
    "bbox": {
      "type": "string",
      "title": "Bounding Box (JSON)"
    },
    "review_status": {
      "type": "string",
      "title": "Review Status",
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "edited"
      ],
      "default": "pending"
    },
    "final_value": {
      "type": "string",
      "title": "Final Value (after review/edit)"
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By Name"
    },
    "reviewed_by_user_id": {
      "type": "string",
      "title": "Reviewed By User ID"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes"
    },
    "field_type": {
      "type": "string",
      "title": "Field Type",
      "enum": [
        "text",
        "date",
        "number",
        "enum",
        "entity_reference",
        "name",
        "authority"
      ],
      "default": "text"
    }
  },
  "required": [
    "organization_id",
    "instrument_id",
    "field_key",
    "review_status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}