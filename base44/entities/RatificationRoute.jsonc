{
  "name": "RatificationRoute",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "required_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0646\u0648\u0627\u062a\u062c \u0627\u0644\u062a\u064a \u062a\u0642\u062a\u0636\u064a \u062a\u0635\u062f\u064a\u0642\u064b\u0627 (Output classes requiring ratification \u2014 an empty list is the institution's own decision that none does)"
    },
    "authority_seat_id": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u0644\u062a\u0635\u062f\u064a\u0642 (\u0627\u0644\u0645\u0642\u0639\u062f) \u2014 \u064a\u064f\u0642\u0627\u0631\u064e\u0646 \u0628\u0627\u0644\u0645\u0639\u0631\u0651\u0641\u060c \u0648\u0644\u0627 \u062a\u064f\u0642\u0628\u0644 \u0645\u0637\u0627\u0628\u0642\u0629 \u0628\u0627\u0644\u0627\u0633\u0645 (Ratifying seat \u2014 compared by identifier, never by name)"
    },
    "authority_role": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u0644\u062a\u0635\u062f\u064a\u0642 (\u0627\u0644\u0635\u0641\u0629) \u2014 \u062a\u064f\u0642\u0631\u0623 \u0645\u0646 \u0645\u0642\u0639\u062f \u0627\u0644\u0641\u0627\u0639\u0644 \u0646\u0641\u0633\u0647 (Ratifying role, read from the actor's own seat)"
    },
    "authority_name": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u0644\u062a\u0635\u062f\u064a\u0642 (\u0644\u0644\u0639\u0631\u0636 \u0641\u0642\u0637) \u2014 display only"
    },
    "authority_external": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u062a\u0635\u062f\u064a\u0642 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0646\u0635\u0629 \u2014 \u062a\u064f\u0633\u062c\u064e\u0651\u0644 \u0648\u0644\u0627 \u064a\u064f\u0646\u0641\u064e\u0651\u0630 \u0627\u0644\u062a\u0635\u062f\u064a\u0642 \u0628\u0627\u0644\u0646\u064a\u0627\u0628\u0629 \u0639\u0646\u0647\u0627 (An authority outside the platform: recorded, and never acted for)"
    },
    "window_days": {
      "type": "number",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0635\u062f\u064a\u0642 \u0628\u0627\u0644\u0623\u064a\u0627\u0645 (\u0635\u0641\u0631 \u0623\u0648 \u063a\u064a\u0627\u0628 = \u0628\u0644\u0627 \u0645\u062f\u0629 \u0645\u062d\u062f\u062f\u0629) \u2014 the window is measured from the route's own recorded instant"
    },
    "on_lapse": {
      "type": "string",
      "title": "\u0623\u062b\u0631 \u0627\u0646\u0642\u0636\u0627\u0621 \u0627\u0644\u0645\u062f\u0629 \u2014 \u0644\u0627 \u064a\u064f\u0646\u062a\u062c \u0627\u0639\u062a\u0645\u0627\u062f\u064b\u0627 \u0641\u064a \u0623\u064a \u062d\u0627\u0644 (What a lapse does \u2014 it never produces an approval)",
      "enum": [
        "not_effective",
        "returned_for_reconsideration"
      ]
    },
    "instrument_basis": {
      "type": "string",
      "title": "\u0646\u0635\u0651 \u0627\u0644\u0633\u0646\u062f \u0627\u0644\u0646\u0638\u0627\u0645\u064a \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0646\u062f \u0625\u0644\u064a\u0647 \u0627\u0644\u0645\u0633\u0627\u0631 (The instrument clause the route rests on \u2014 required)"
    },
    "policy_version": {
      "type": "string",
      "title": "Policy Revision Stated by the Institution"
    },
    "contract_version": {
      "type": "string",
      "title": "Ratification Route Contract Version in Force"
    },
    "recorded_by_user_id": {
      "type": "string",
      "title": "Recorded By (user id)"
    },
    "recorded_by_name": {
      "type": "string",
      "title": "Recorded By (display only)"
    },
    "recorded_at": {
      "type": "string",
      "title": "Recorded At (server clock)",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629: \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0633\u0627\u0628\u0642 \u064a\u064f\u0633\u062a\u0628\u062f\u0644 \u0648\u0644\u0627 \u064a\u064f\u0639\u0627\u062f \u0643\u062a\u0627\u0628\u062a\u0647 \u2014 a superseded route is preserved, never rewritten",
      "enum": [
        "active",
        "superseded"
      ],
      "default": "active"
    },
    "data_origin": {
      "type": "string",
      "title": "Data Origin (internal provenance)",
      "enum": [
        "source_based",
        "synthetic_presentational",
        "operational"
      ],
      "default": "operational"
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_dataset": {
      "type": "string",
      "title": "Demo Dataset Key"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "required_for",
    "on_lapse",
    "instrument_basis",
    "contract_version",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}