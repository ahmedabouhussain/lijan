{
  "name": "ExternalReference",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "raqeem_entity_type": {
      "type": "string",
      "title": "LIJAN Entity Type",
      "enum": [
        "Meeting",
        "Decision",
        "Action",
        "Committee",
        "Institution",
        "Document"
      ]
    },
    "raqeem_record_id": {
      "type": "string",
      "title": "LIJAN Record ID"
    },
    "user_id": {
      "type": "string",
      "title": "Connected User ID (per-member external mapping)"
    },
    "external_system": {
      "type": "string",
      "title": "External System",
      "enum": [
        "teams",
        "zoom",
        "webex",
        "google_meet",
        "outlook",
        "google_calendar",
        "gmail",
        "sharepoint",
        "google_drive",
        "erp",
        "hr",
        "dms",
        "esign",
        "government_api",
        "sovereign_channel",
        "other"
      ]
    },
    "external_record_id": {
      "type": "string",
      "title": "External Record ID"
    },
    "external_record_type": {
      "type": "string",
      "title": "External Record Type"
    },
    "external_url": {
      "type": "string",
      "title": "External URL",
      "format": "uri"
    },
    "mapping_type": {
      "type": "string",
      "title": "Mapping Type",
      "enum": [
        "created_in",
        "synced_to",
        "linked",
        "mirrored",
        "propagated_to"
      ],
      "default": "linked"
    },
    "sync_status": {
      "type": "string",
      "title": "Sync Status",
      "enum": [
        "synced",
        "pending",
        "failed",
        "stale",
        "manual",
        "not_configured"
      ],
      "default": "not_configured"
    },
    "last_synced_at": {
      "type": "string",
      "title": "Last Synced At",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "raqeem_entity_type",
    "raqeem_record_id",
    "external_system",
    "sync_status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}