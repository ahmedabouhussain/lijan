{
  "name": "VotingRule",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "rule_type": {
      "type": "string",
      "title": "Voting Rule Type",
      "enum": [
        "simple_majority",
        "two_thirds",
        "unanimous",
        "chair_decides",
        "qualified_majority",
        "custom"
      ],
      "default": "simple_majority"
    },
    "pass_threshold_percentage": {
      "type": "number",
      "title": "Pass Threshold %",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "abstention_counts_as": {
      "type": "string",
      "title": "Abstention Counts As",
      "enum": [
        "no_vote",
        "against",
        "neutral"
      ],
      "default": "no_vote"
    },
    "chair_casts_deciding_vote": {
      "type": "boolean",
      "title": "Chair Casts Deciding Vote on Tie",
      "default": false
    },
    "secret_ballot_allowed": {
      "type": "boolean",
      "title": "Secret Ballot Allowed",
      "default": false
    },
    "voting_method": {
      "type": "string",
      "title": "Default Voting Method",
      "enum": [
        "open",
        "roll_call",
        "secret"
      ],
      "default": "open"
    },
    "effective_date": {
      "type": "string",
      "title": "Effective Date",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "superseded",
        "draft"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "rule_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}