{
  "name": "AuthorityDelegation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "type": {
      "type": "string",
      "title": "Type"
    },
    "from_member_name": {
      "type": "string",
      "title": "From Member"
    },
    "from_member_name_en": {
      "type": "string",
      "title": "From Member (English)"
    },
    "from_member_role": {
      "type": "string",
      "title": "From Role"
    },
    "to_member_name": {
      "type": "string",
      "title": "To Member"
    },
    "to_member_name_en": {
      "type": "string",
      "title": "To Member (English)"
    },
    "to_member_role": {
      "type": "string",
      "title": "To Role"
    },
    "scope": {
      "type": "string",
      "title": "Scope of Authority Transfer"
    },
    "scope_en": {
      "type": "string",
      "title": "Scope of Authority Transfer (English)"
    },
    "decision_id": {
      "type": "string",
      "title": "Related Decision ID"
    },
    "reason": {
      "type": "string",
      "title": "Reason (Recusal / Justification)"
    },
    "reason_en": {
      "type": "string",
      "title": "Reason (English)"
    },
    "start_date": {
      "type": "string",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "title": "End Date"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "committee_id",
    "type",
    "from_member_name",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}