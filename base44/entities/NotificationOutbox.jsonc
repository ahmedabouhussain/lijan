{
  "name": "NotificationOutbox",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID (optional)"
    },
    "recipient_user_id": {
      "type": "string",
      "title": "Recipient User ID"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email",
      "format": "email"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient Name"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "meeting_scheduled",
        "meeting_reminder",
        "meeting_started",
        "meeting_adjourned",
        "meeting_cancelled",
        "agenda_published",
        "pack_published",
        "decision_issued",
        "decision_voting_open",
        "action_assigned",
        "action_reminder",
        "action_overdue",
        "action_extension_requested",
        "action_extension_reviewed",
        "amendment_proposed",
        "amendment_approved",
        "amendment_rejected",
        "minutes_published",
        "minutes_approval_requested",
        "invitation_sent",
        "escalation_triggered",
        "review_requested",
        "review_responded",
        "recusal_recorded",
        "delegation_granted",
        "conflict_declared",
        "committee_activated",
        "committee_suspended",
        "committee_closed",
        "calendar_synced",
        "calendar_sync_failed",
        "custom"
      ],
      "default": "custom"
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "email",
        "in_app",
        "teams",
        "push"
      ],
      "default": "in_app"
    },
    "subject_ar": {
      "type": "string",
      "title": "Subject (Arabic)"
    },
    "subject_en": {
      "type": "string",
      "title": "Subject (English)"
    },
    "body_ar": {
      "type": "string",
      "title": "Body (Arabic)"
    },
    "body_en": {
      "type": "string",
      "title": "Body (English)"
    },
    "deep_link": {
      "type": "string",
      "title": "Deep Link (URL to relevant record)"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "read",
        "failed",
        "suppressed"
      ],
      "default": "queued"
    },
    "scheduled_for": {
      "type": "string",
      "title": "Scheduled For",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At",
      "format": "date-time"
    },
    "read_at": {
      "type": "string",
      "title": "Read At",
      "format": "date-time"
    },
    "failure_reason": {
      "type": "string",
      "title": "Failure Reason"
    },
    "correlation_id": {
      "type": "string",
      "title": "Correlation ID"
    },
    "actor_name": {
      "type": "string",
      "title": "Actor Name (who triggered)"
    }
  },
  "required": [
    "organization_id",
    "recipient_user_id",
    "event_type",
    "channel",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}