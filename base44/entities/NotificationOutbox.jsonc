{
  "name": "NotificationOutbox",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID (optional)"
    },
    "recipient_user_id": {
      "type": "string",
      "title": "Recipient User ID"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient Name"
    },
    "recipient_name_en": {
      "type": "string",
      "title": "Recipient Name (English)"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type"
    },
    "channel": {
      "type": "string",
      "title": "Channel"
    },
    "subject_ar": {
      "type": "string",
      "title": "Subject (Arabic)"
    },
    "subject_en": {
      "type": "string",
      "title": "Subject (English)"
    },
    "body_ar": {
      "type": "string",
      "title": "Body (Arabic)"
    },
    "body_en": {
      "type": "string",
      "title": "Body (English)"
    },
    "deep_link": {
      "type": "string",
      "title": "Deep Link (URL to relevant record)"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "source_title_en": {
      "type": "string",
      "title": "Source Title (English)"
    },
    "priority": {
      "type": "string",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "title": "Delivery Status (queued \u2192 dispatching \u2192 delivered | failed | retry_scheduled; not_required when suppressed. Read state lives in read_at, never here.)"
    },
    "scheduled_for": {
      "type": "string",
      "title": "Scheduled For"
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At"
    },
    "read_at": {
      "type": "string",
      "title": "Read At"
    },
    "failure_reason": {
      "type": "string",
      "title": "Failure Reason"
    },
    "attempt_count": {
      "type": "number",
      "title": "Delivery Attempt Count",
      "default": 0
    },
    "last_attempt_at": {
      "type": "string",
      "title": "Last Delivery Attempt At",
      "format": "date-time"
    },
    "next_retry_at": {
      "type": "string",
      "title": "Next Scheduled Retry",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "title": "Idempotency Key (one notice per transition and recipient)"
    },
    "transition_id": {
      "type": "string",
      "title": "Transition ID (the state transition this notice belongs to)"
    },
    "last_retry_key": {
      "type": "string",
      "title": "Last Retry Request Key"
    },
    "correlation_id": {
      "type": "string",
      "title": "Correlation ID"
    },
    "actor_name": {
      "type": "string",
      "title": "Actor Name (who triggered)"
    },
    "actor_name_en": {
      "type": "string",
      "title": "Actor Name (English)"
    }
  },
  "required": [
    "organization_id",
    "recipient_user_id",
    "event_type",
    "channel",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}