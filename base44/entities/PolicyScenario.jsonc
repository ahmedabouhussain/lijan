{
  "name": "PolicyScenario",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "decision_id": {
      "type": "string",
      "title": "Related Decision ID"
    },
    "title": {
      "type": "string",
      "title": "Scenario Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "scenario_type": {
      "type": "string",
      "title": "Scenario Type",
      "enum": [
        "baseline",
        "alternative",
        "preferred",
        "rejected"
      ],
      "default": "alternative"
    },
    "projected_impact": {
      "type": "string",
      "title": "Projected Impact"
    },
    "projected_cost": {
      "type": "string",
      "title": "Projected Cost"
    },
    "projected_timeline": {
      "type": "string",
      "title": "Projected Timeline"
    },
    "risk_level": {
      "type": "string",
      "title": "Risk Level",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "risk_assessment": {
      "type": "string",
      "title": "Risk Assessment"
    },
    "stakeholders_affected": {
      "type": "string",
      "title": "Stakeholders Affected"
    },
    "ai_generated": {
      "type": "boolean",
      "title": "AI Generated",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "evaluating",
        "selected",
        "rejected",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "scenario_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}