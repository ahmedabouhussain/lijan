{
  "name": "CommitteeAmendment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "amendment_type": {
      "type": "string",
      "title": "Amendment Type"
    },
    "source_instrument_id": {
      "type": "string",
      "title": "Source Founding Instrument ID"
    },
    "source_instrument_ref": {
      "type": "string",
      "title": "Source Instrument Reference (display)"
    },
    "source_instrument_ref_en": {
      "type": "string",
      "title": "Source Instrument Reference (English)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "description_en": {
      "type": "string",
      "title": "Description (English)"
    },
    "before_state": {
      "type": "string",
      "title": "Before State (JSON)"
    },
    "after_state": {
      "type": "string",
      "title": "After State (JSON)"
    },
    "impact_analysis": {
      "type": "string",
      "title": "Impact Analysis (JSON)"
    },
    "impact_summary": {
      "type": "string",
      "title": "Impact Summary (human-readable)"
    },
    "impact_summary_en": {
      "type": "string",
      "title": "Impact Summary (English)"
    },
    "effective_date": {
      "type": "string",
      "title": "Effective Date"
    },
    "status": {
      "type": "string",
      "title": "Status"
    },
    "proposed_by_user_id": {
      "type": "string",
      "title": "Proposed By User ID"
    },
    "proposed_by_name": {
      "type": "string",
      "title": "Proposed By Name"
    },
    "proposed_by_name_en": {
      "type": "string",
      "title": "Proposed By Name (English)"
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By Name"
    },
    "reviewed_by_name_en": {
      "type": "string",
      "title": "Reviewed By Name (English)"
    },
    "approved_by_name": {
      "type": "string",
      "title": "Approved By Name"
    },
    "approved_by_name_en": {
      "type": "string",
      "title": "Approved By Name (English)"
    },
    "approved_at": {
      "type": "string",
      "title": "Approved At"
    },
    "applied_at": {
      "type": "string",
      "title": "Applied At"
    },
    "formation_version_id": {
      "type": "string",
      "title": "Resulting Formation Version ID"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "notes_en": {
      "type": "string",
      "title": "Notes (English)"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "amendment_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}