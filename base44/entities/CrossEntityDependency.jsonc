{
  "name": "CrossEntityDependency",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_id": {
      "type": "string",
      "title": "Source Record ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "source_title_en": {
      "type": "string",
      "title": "Source Title (English)"
    },
    "source_committee_id": {
      "type": "string",
      "title": "Source Committee ID"
    },
    "target_entity_type": {
      "type": "string",
      "title": "Target Entity Type"
    },
    "target_id": {
      "type": "string",
      "title": "Target Record ID"
    },
    "target_title": {
      "type": "string",
      "title": "Target Title"
    },
    "target_title_en": {
      "type": "string",
      "title": "Target Title (English)"
    },
    "target_committee_id": {
      "type": "string",
      "title": "Target Committee ID"
    },
    "target_institution_id": {
      "type": "string",
      "title": "Target Institution ID"
    },
    "dependency_type": {
      "type": "string",
      "title": "Dependency Type"
    },
    "status": {
      "type": "string",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "notes_en": {
      "type": "string",
      "title": "Notes (English)"
    }
  },
  "required": [
    "organization_id",
    "source_entity_type",
    "source_id",
    "source_title",
    "target_entity_type",
    "target_id",
    "target_title",
    "dependency_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}