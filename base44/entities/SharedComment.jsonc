{
  "name": "SharedComment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "document_version_id": {
      "type": "string",
      "title": "Document Version ID"
    },
    "agenda_item_id": {
      "type": "string",
      "title": "Agenda Item ID"
    },
    "author_user_id": {
      "type": "string",
      "title": "Author User ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "author_role": {
      "type": "string",
      "title": "Author Role"
    },
    "body": {
      "type": "string",
      "title": "Comment Body"
    },
    "body_ar": {
      "type": "string",
      "title": "\u0646\u0635 \u0627\u0644\u062a\u0639\u0644\u064a\u0642"
    },
    "parent_comment_id": {
      "type": "string",
      "title": "Parent Comment ID (for threading)"
    },
    "is_governed": {
      "type": "boolean",
      "title": "Governed (part of official record)",
      "default": true
    },
    "created_at": {
      "type": "string",
      "title": "Created At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "resolved",
        "withdrawn"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "author_name",
    "body",
    "created_at",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}