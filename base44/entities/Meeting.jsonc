{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "title": {
      "type": "string",
      "title": "Meeting Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "date": {
      "type": "string",
      "title": "Date & Time",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes)",
      "default": 60
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "mode": {
      "type": "string",
      "title": "Meeting Mode",
      "enum": [
        "physical",
        "online",
        "hybrid"
      ],
      "default": "hybrid"
    },
    "provider": {
      "type": "string",
      "title": "Meeting Provider",
      "enum": [
        "teams",
        "zoom",
        "webex",
        "google_meet",
        "external_link",
        "sovereign",
        "none"
      ],
      "default": "none"
    },
    "meeting_url": {
      "type": "string",
      "title": "Meeting URL"
    },
    "quorum_required": {
      "type": "number",
      "title": "Quorum Required",
      "default": 3
    },
    "agenda_ready": {
      "type": "boolean",
      "title": "Agenda Ready",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "scheduled",
        "in_progress",
        "adjourned",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "series_id": {
      "type": "string",
      "title": "Series ID (groups recurring instances)"
    },
    "is_series_master": {
      "type": "boolean",
      "title": "Is Series Master (template)",
      "default": false
    },
    "parent_meeting_id": {
      "type": "string",
      "title": "Parent Meeting ID (series master for exceptions)"
    },
    "recurrence_type": {
      "type": "string",
      "title": "Recurrence Type",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly",
        "quarterly"
      ],
      "default": "none"
    },
    "recurrence_rrule": {
      "type": "string",
      "title": "RFC 5545 RRULE String"
    },
    "recurrence_interval": {
      "type": "number",
      "title": "Recurrence Interval (every N units)",
      "default": 1
    },
    "recurrence_count": {
      "type": "number",
      "title": "Total Occurrences (null = until recurrence_until)"
    },
    "recurrence_until": {
      "type": "string",
      "title": "Recurrence End Date",
      "format": "date-time"
    },
    "recurrence_days_of_week": {
      "type": "string",
      "title": "Days of Week (comma-separated 0-6, for weekly)"
    },
    "recurrence_month_day": {
      "type": "number",
      "title": "Day of Month (for monthly)"
    },
    "is_exception": {
      "type": "boolean",
      "title": "Is Exception (modified from series pattern)",
      "default": false
    },
    "is_cancelled_exception": {
      "type": "boolean",
      "title": "Is Cancelled Exception (removed from series)",
      "default": false
    },
    "series_instance_number": {
      "type": "number",
      "title": "Instance Number in Series",
      "default": 1
    }
  },
  "required": [
    "committee_id",
    "title",
    "date",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}