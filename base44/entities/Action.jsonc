{
  "name": "Action",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "decision_id": {
      "type": "string",
      "title": "Decision ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID (where the action was assigned)"
    },
    "agenda_item_id": {
      "type": "string",
      "title": "Related Agenda Item ID"
    },
    "workstream_id": {
      "type": "string",
      "title": "Owning Workstream ID"
    },
    "title": {
      "type": "string",
      "title": "Action Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "title_en": {
      "type": "string",
      "title": "Action Title (English)"
    },
    "owner_name": {
      "type": "string",
      "title": "Owner"
    },
    "owner_name_en": {
      "type": "string",
      "title": "Owner (English)"
    },
    "owner_user_id": {
      "type": "string",
      "title": "Owner User ID (identity of record \u2014 an assignee may act only on their own action)"
    },
    "owner_organization_id": {
      "type": "string",
      "title": "Owner Organization ID"
    },
    "responsible_department": {
      "type": "string",
      "title": "Responsible Department"
    },
    "responsible_department_en": {
      "type": "string",
      "title": "Responsible Department (English)"
    },
    "contributors": {
      "type": "string",
      "title": "Contributors"
    },
    "required_evidence": {
      "type": "string",
      "title": "Required Evidence"
    },
    "required_evidence_en": {
      "type": "string",
      "title": "Required Evidence (English)"
    },
    "deadline": {
      "type": "string",
      "title": "Deadline",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "progress_percent": {
      "type": "number",
      "title": "Progress %",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "blocker": {
      "type": "string",
      "title": "Blocker Description"
    },
    "evidence_url": {
      "type": "string",
      "title": "Evidence URL",
      "format": "uri"
    },
    "escalation_level": {
      "type": "string",
      "title": "Escalation Level",
      "enum": [
        "none",
        "reminder",
        "priority_reminder",
        "owner_secretary",
        "chair",
        "escalation_authority"
      ],
      "default": "none"
    },
    "extension_status": {
      "type": "string",
      "title": "Extension Status",
      "enum": [
        "none",
        "requested",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "extension_reason": {
      "type": "string",
      "title": "Extension Reason"
    },
    "extension_new_deadline": {
      "type": "string",
      "title": "Requested New Deadline",
      "format": "date"
    },
    "extension_reviewed_by": {
      "type": "string",
      "title": "Extension Reviewed By"
    },
    "last_reminder_at": {
      "type": "string",
      "title": "Last Reminder At",
      "format": "date-time"
    },
    "reminder_count": {
      "type": "number",
      "title": "Reminder Count",
      "default": 0
    },
    "escalation_revision": {
      "type": "number",
      "title": "Escalation Revision (compare-and-set lock)",
      "default": 0
    },
    "escalation_transition_id": {
      "type": "string",
      "title": "Escalation Transition ID (identifies the request that actually moved the action)"
    },
    "last_escalation_key": {
      "type": "string",
      "title": "Last Escalation Idempotency Key"
    },
    "last_escalation_at": {
      "type": "string",
      "title": "Last Escalation At",
      "format": "date-time"
    },
    "last_escalation_correlation": {
      "type": "string",
      "title": "Last Escalation Correlation ID"
    },
    "escalation_notice_state": {
      "type": "string",
      "title": "Escalation Notice State (delivery truth: queued until a channel confirms, never notified on a record alone)",
      "enum": [
        "not_required",
        "no_recipient",
        "queued",
        "dispatching",
        "delivered",
        "partially_delivered",
        "failed",
        "retry_scheduled"
      ],
      "default": "not_required"
    },
    "compliance_verified": {
      "type": "boolean",
      "title": "Compliance Verified",
      "default": false
    },
    "compliance_notes": {
      "type": "string",
      "title": "Compliance Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "assigned",
        "in_progress",
        "blocked",
        "evidence_pending",
        "under_review",
        "verified",
        "closed",
        "overdue"
      ],
      "default": "assigned"
    },
    "data_origin": {
      "type": "string",
      "title": "Data Origin (internal provenance)",
      "enum": [
        "source_based",
        "synthetic_presentational",
        "operational"
      ],
      "default": "operational"
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_dataset": {
      "type": "string",
      "title": "Demo Dataset Key"
    }
  },
  "required": [
    "committee_id",
    "title",
    "owner_name",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}