{
  "name": "Action",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "decision_id": {
      "type": "string",
      "title": "Decision ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "title": {
      "type": "string",
      "title": "Action Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "owner_name": {
      "type": "string",
      "title": "Owner"
    },
    "responsible_department": {
      "type": "string",
      "title": "Responsible Department"
    },
    "contributors": {
      "type": "string",
      "title": "Contributors"
    },
    "deadline": {
      "type": "string",
      "title": "Deadline",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "progress_percent": {
      "type": "number",
      "title": "Progress %",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "blocker": {
      "type": "string",
      "title": "Blocker Description"
    },
    "evidence_url": {
      "type": "string",
      "title": "Evidence URL",
      "format": "uri"
    },
    "escalation_level": {
      "type": "string",
      "title": "Escalation Level",
      "enum": [
        "none",
        "reminder",
        "priority_reminder",
        "owner_secretary",
        "chair",
        "escalation_authority"
      ],
      "default": "none"
    },
    "extension_status": {
      "type": "string",
      "title": "Extension Status",
      "enum": [
        "none",
        "requested",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "extension_reason": {
      "type": "string",
      "title": "Extension Reason"
    },
    "extension_new_deadline": {
      "type": "string",
      "title": "Requested New Deadline",
      "format": "date"
    },
    "extension_reviewed_by": {
      "type": "string",
      "title": "Extension Reviewed By"
    },
    "last_reminder_at": {
      "type": "string",
      "title": "Last Reminder At",
      "format": "date-time"
    },
    "reminder_count": {
      "type": "number",
      "title": "Reminder Count",
      "default": 0
    },
    "compliance_verified": {
      "type": "boolean",
      "title": "Compliance Verified",
      "default": false
    },
    "compliance_notes": {
      "type": "string",
      "title": "Compliance Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "assigned",
        "in_progress",
        "blocked",
        "evidence_pending",
        "under_review",
        "verified",
        "closed",
        "overdue"
      ],
      "default": "assigned"
    }
  },
  "required": [
    "committee_id",
    "title",
    "owner_name",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}