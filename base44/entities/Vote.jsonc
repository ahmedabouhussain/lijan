{
  "name": "Vote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "decision_id": {
      "type": "string",
      "title": "Decision ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID"
    },
    "voter_name": {
      "type": "string",
      "title": "Voter Full Name (display only)"
    },
    "voter_user_id": {
      "type": "string",
      "title": "Voter User ID \u2014 identity of record"
    },
    "voter_membership_id": {
      "type": "string",
      "title": "Voter Seat (committee membership id) \u2014 identity of record"
    },
    "eligible_voter_snapshot_id": {
      "type": "string",
      "title": "Eligible-Voter Snapshot this vote was cast against"
    },
    "voter_role": {
      "type": "string",
      "title": "Voter Role",
      "enum": [
        "chair",
        "vice_chair",
        "secretary",
        "member",
        "observer",
        "advisor"
      ],
      "default": "member"
    },
    "vote_choice": {
      "type": "string",
      "title": "Vote Choice",
      "enum": [
        "for",
        "against",
        "abstain"
      ],
      "default": "abstain"
    },
    "dissent_reason": {
      "type": "string",
      "title": "Dissent Reason"
    },
    "vote_method": {
      "type": "string",
      "title": "Vote Method",
      "enum": [
        "open",
        "secret"
      ],
      "default": "open"
    },
    "voted_at": {
      "type": "string",
      "title": "Voted At",
      "format": "date-time"
    }
  },
  "required": [
    "decision_id",
    "voter_name",
    "vote_choice",
    "voted_at"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}