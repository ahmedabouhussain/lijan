{
  "name": "Initiative",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "workstream_en": {
      "type": "string",
      "title": "Workstream (English)"
    },
    "workstream_ar": {
      "type": "string",
      "title": "\u0645\u0633\u0627\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "title": {
      "type": "string",
      "title": "Initiative Title"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0629"
    },
    "objective": {
      "type": "string",
      "title": "Institutional Objective"
    },
    "objective_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u062f\u0641 \u0627\u0644\u0645\u0624\u0633\u0633\u064a"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "proposed",
        "under_review",
        "prioritized",
        "approved",
        "in_delivery",
        "blocked",
        "measuring_impact",
        "closed"
      ],
      "default": "prioritized"
    },
    "proposed_owner": {
      "type": "string",
      "title": "Proposed Owner"
    },
    "owner_verification_status": {
      "type": "string",
      "title": "Owner Verification Status",
      "enum": [
        "confirmed",
        "needs_confirmation"
      ],
      "default": "needs_confirmation"
    },
    "supporting_entities": {
      "type": "string",
      "title": "Supporting Entities"
    },
    "dependencies": {
      "type": "string",
      "title": "Dependencies"
    },
    "required_evidence": {
      "type": "string",
      "title": "Required Evidence"
    },
    "risks": {
      "type": "string",
      "title": "Risks / Blockers"
    },
    "requested_decision": {
      "type": "string",
      "title": "Requested Committee Decision"
    },
    "milestones": {
      "type": "string",
      "title": "Milestones"
    },
    "impact_indicators": {
      "type": "string",
      "title": "Impact Indicators"
    },
    "source_reference": {
      "type": "string",
      "title": "Source Reference"
    },
    "source_as_of": {
      "type": "string",
      "title": "Source As Of",
      "format": "date"
    },
    "freshness_status": {
      "type": "string",
      "title": "Freshness Status",
      "enum": [
        "fresh",
        "stale",
        "needs_confirmation"
      ],
      "default": "fresh"
    },
    "next_permitted_action": {
      "type": "string",
      "title": "Next Permitted Action"
    },
    "sequence": {
      "type": "number",
      "title": "Sequence",
      "default": 1
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_scenario_id": {
      "type": "string",
      "title": "Demo Scenario ID"
    }
  },
  "required": [
    "committee_id",
    "title",
    "title_ar",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}