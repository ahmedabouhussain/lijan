{
  "name": "CommitteeFormationVersion",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "effective_date": {
      "type": "string",
      "title": "Effective Date",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "title": "End Date (null = current)",
      "format": "date"
    },
    "source_instrument_id": {
      "type": "string",
      "title": "Source Founding Instrument ID"
    },
    "source_instrument_ref": {
      "type": "string",
      "title": "Source Instrument Reference (display)"
    },
    "amendment_id": {
      "type": "string",
      "title": "Originating Amendment ID"
    },
    "reason_for_change": {
      "type": "string",
      "title": "Reason for Change"
    },
    "approving_authority": {
      "type": "string",
      "title": "Approving Authority"
    },
    "formation_snapshot": {
      "type": "string",
      "title": "Formation Snapshot (JSON array of members)"
    },
    "member_count": {
      "type": "number",
      "title": "Member Count",
      "default": 0
    },
    "chair_name": {
      "type": "string",
      "title": "Chair Name (at this version)"
    },
    "is_current": {
      "type": "boolean",
      "title": "Is Current Version",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "active",
        "superseded",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "version_number",
    "effective_date",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}