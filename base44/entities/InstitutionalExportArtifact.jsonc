{
  "name": "InstitutionalExportArtifact",
  "type": "object",
  "properties": {
    "committee_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "showcase_session_id": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "xlsx"
      ]
    },
    "filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "sha256": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "inspection_status": {
      "type": "string"
    },
    "inspection_notes": {
      "type": "string"
    }
  },
  "required": [
    "committee_id",
    "product_type",
    "file_uri",
    "sha256",
    "generator_version",
    "source_record_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}