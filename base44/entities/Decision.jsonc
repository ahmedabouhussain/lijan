{
  "name": "Decision",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID"
    },
    "decision_number": {
      "type": "string",
      "title": "Decision Number"
    },
    "title": {
      "type": "string",
      "title": "Decision Title (English)"
    },
    "title_ar": {
      "type": "string",
      "title": "\u0646\u0635 \u0627\u0644\u0642\u0631\u0627\u0631"
    },
    "title_en": {
      "type": "string",
      "title": "Decision Title (English edition)"
    },
    "proposal": {
      "type": "string",
      "title": "Proposal / Draft"
    },
    "proposal_en": {
      "type": "string",
      "title": "Proposal / Draft (English)"
    },
    "legal_basis": {
      "type": "string",
      "title": "Legal Basis"
    },
    "legal_basis_en": {
      "type": "string",
      "title": "Legal Basis (English)"
    },
    "alternatives": {
      "type": "string",
      "title": "Alternatives Considered"
    },
    "deliberation_summary": {
      "type": "string",
      "title": "Deliberation Summary"
    },
    "vote_for": {
      "type": "number",
      "title": "Votes For"
    },
    "vote_against": {
      "type": "number",
      "title": "Votes Against"
    },
    "vote_abstain": {
      "type": "number",
      "title": "Abstentions"
    },
    "dissent": {
      "type": "string",
      "title": "Dissent Recorded"
    },
    "owner_name": {
      "type": "string",
      "title": "Execution Owner"
    },
    "owner_name_en": {
      "type": "string",
      "title": "Execution Owner (English)"
    },
    "deadline": {
      "type": "string",
      "title": "Execution Deadline"
    },
    "dependencies": {
      "type": "string",
      "title": "Dependencies"
    },
    "dependencies_en": {
      "type": "string",
      "title": "Dependencies (English)"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome"
    },
    "outcome_en": {
      "type": "string",
      "title": "Outcome (English)"
    },
    "impact": {
      "type": "string",
      "title": "Impact Assessment"
    },
    "impact_en": {
      "type": "string",
      "title": "Impact Assessment (English)"
    },
    "superseded_by": {
      "type": "string",
      "title": "Superseded By Decision ID"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "committee_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}