{
  "name": "AlternateActivation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "alternate_member_id": {
      "type": "string",
      "title": "Alternate Member ID"
    },
    "alternate_member_name": {
      "type": "string",
      "title": "Alternate Member Name"
    },
    "principal_member_id": {
      "type": "string",
      "title": "Principal Member ID"
    },
    "principal_member_name": {
      "type": "string",
      "title": "Principal Member Name"
    },
    "activated_at": {
      "type": "string",
      "title": "Activated At",
      "format": "date-time"
    },
    "deactivated_at": {
      "type": "string",
      "title": "Deactivated At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "expired"
      ],
      "default": "active"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "alternate_member_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}