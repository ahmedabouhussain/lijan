{
  "name": "ProductInstance",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "product_template_id": {
      "type": "string",
      "title": "Product Template ID"
    },
    "product_type": {
      "type": "string",
      "title": "Product Type",
      "enum": [
        "meeting_minutes",
        "decision_document",
        "committee_charter",
        "formation_decision",
        "amendment_decision",
        "action_report",
        "annual_report",
        "quarterly_report",
        "committee_report",
        "attendance_report",
        "voting_record",
        "executive_summary",
        "policy_brief",
        "risk_report",
        "escalation_report",
        "audit_report",
        "governance_report",
        "memory_transfer",
        "meeting_pack",
        "agenda",
        "invitation_letter",
        "resolution",
        "compliance_report",
        "custom"
      ],
      "default": "custom"
    },
    "title": {
      "type": "string",
      "title": "Product Title"
    },
    "title_ar": {
      "type": "string",
      "title": "Product Title (Arabic)"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "generated_content": {
      "type": "string",
      "title": "Generated Content (JSON \u2014 structured sections)",
      "description": "Array of section objects with title, content, source_references. Never HTML."
    },
    "export_format": {
      "type": "string",
      "title": "Export Format",
      "enum": [
        "pdf",
        "docx",
        "html",
        "print"
      ],
      "default": "pdf"
    },
    "file_url": {
      "type": "string",
      "title": "LEGACY Exported File URL (public links pending migration \u2014 never written for new files)"
    },
    "storage_key": {
      "type": "string",
      "title": "Internal Storage Key (private file reference \u2014 never a public URL)"
    },
    "file_type": {
      "type": "string",
      "title": "File Type (e.g. application/pdf)"
    },
    "file_size_bytes": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "document_fingerprint": {
      "type": "string",
      "title": "Document Fingerprint (SHA-256 of the produced bytes)"
    },
    "file_version": {
      "type": "number",
      "title": "File Version",
      "default": 0
    },
    "file_classification": {
      "type": "string",
      "title": "File Classification (snapshot at generation)"
    },
    "file_owner_user_id": {
      "type": "string",
      "title": "File Owner User ID"
    },
    "file_created_at": {
      "type": "string",
      "title": "File Created At",
      "format": "date-time"
    },
    "export_template": {
      "type": "string",
      "title": "Export Template / Product Identity (the template the file was produced from)"
    },
    "verification_code": {
      "type": "string",
      "title": "Public Verification Code"
    },
    "revoked_at": {
      "type": "string",
      "title": "Revoked At",
      "format": "date-time"
    },
    "revocation_reason": {
      "type": "string",
      "title": "Revocation Reason"
    },
    "classification": {
      "type": "string",
      "title": "Classification",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "highly_restricted"
      ],
      "default": "internal"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "generated",
        "in_review",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "generated_by_user_id": {
      "type": "string",
      "title": "Generated By User ID"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By Name"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At",
      "format": "date-time"
    },
    "approved_by_name": {
      "type": "string",
      "title": "Approved By Name"
    },
    "approved_by_user_id": {
      "type": "string",
      "title": "Approved By User ID"
    },
    "approved_at": {
      "type": "string",
      "title": "Approved At",
      "format": "date-time"
    },
    "ai_model_used": {
      "type": "string",
      "title": "AI Model Used"
    },
    "ai_confidence": {
      "type": "number",
      "title": "AI Confidence (0-1)",
      "default": 0
    },
    "human_edited": {
      "type": "boolean",
      "title": "Human Edited",
      "default": false
    },
    "correlation_id": {
      "type": "string",
      "title": "Correlation ID"
    }
  },
  "required": [
    "organization_id",
    "product_type",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}