{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "meeting_id": {
      "type": "string",
      "title": "Meeting ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "member_id": {
      "type": "string",
      "title": "Committee Member ID"
    },
    "member_name": {
      "type": "string",
      "title": "Member Name"
    },
    "member_name_en": {
      "type": "string",
      "title": "Member Name (English)"
    },
    "member_role": {
      "type": "string",
      "title": "Member Role"
    },
    "attendance_status": {
      "type": "string",
      "title": "Attendance Status"
    },
    "arrival_time": {
      "type": "string",
      "title": "Arrival Time"
    },
    "proxy_for": {
      "type": "string",
      "title": "Proxy For (Member Name)"
    },
    "proxy_for_en": {
      "type": "string",
      "title": "Proxy For (Member Name, English)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "notes_en": {
      "type": "string",
      "title": "Notes (English)"
    }
  },
  "required": [
    "meeting_id",
    "member_name",
    "attendance_status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.active_org_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}