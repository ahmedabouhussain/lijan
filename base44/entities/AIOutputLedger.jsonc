{
  "name": "AIOutputLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "output_type": {
      "type": "string",
      "title": "Output Type"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "source_title_en": {
      "type": "string",
      "title": "Source Title (English)"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "model_used": {
      "type": "string",
      "title": "Model Used"
    },
    "prompt_summary": {
      "type": "string",
      "title": "Prompt Summary"
    },
    "prompt_summary_en": {
      "type": "string",
      "title": "Prompt Summary (English)"
    },
    "output_summary": {
      "type": "string",
      "title": "Output Summary (plain text \u2014 no HTML/Markdown)"
    },
    "output_summary_en": {
      "type": "string",
      "title": "Output Summary (English)"
    },
    "structured_content": {
      "type": "string",
      "title": "Structured Content (JSON-serialized sections)"
    },
    "output_url": {
      "type": "string",
      "title": "Output URL"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At"
    },
    "generated_by_user_id": {
      "type": "string",
      "title": "Generated By User ID"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By Name"
    },
    "generated_by_name_en": {
      "type": "string",
      "title": "Generated By Name (English)"
    },
    "human_reviewed": {
      "type": "boolean",
      "title": "Human Reviewed"
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By Name"
    },
    "reviewed_by_name_en": {
      "type": "string",
      "title": "Reviewed By Name (English)"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes"
    },
    "review_notes_en": {
      "type": "string",
      "title": "Review Notes (English)"
    },
    "approved": {
      "type": "boolean",
      "title": "Approved"
    },
    "confidence_score": {
      "type": "number",
      "title": "Confidence Score (0.0\u20131.0 \u2014 the model's own self-assessment, never a guarantee)",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_basis": {
      "type": "string",
      "title": "Confidence Basis (what the score rests on \u2014 source coverage, ambiguity, novelty)"
    },
    "feedback_rating": {
      "type": "string",
      "title": "Human Feedback Rating (helpful / needs_correction / not_helpful \u2014 a human verdict, never a model self-assessment)",
      "enum": [
        "helpful",
        "needs_correction",
        "not_helpful"
      ]
    },
    "feedback_note": {
      "type": "string",
      "title": "Feedback Note (what the human found wrong or right \u2014 the basis for improving the governed prompt)"
    },
    "feedback_by_user_id": {
      "type": "string",
      "title": "Feedback By User ID"
    },
    "feedback_by_name": {
      "type": "string",
      "title": "Feedback By Name"
    },
    "feedback_at": {
      "type": "string",
      "title": "Feedback At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "output_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}