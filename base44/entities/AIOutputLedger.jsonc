{
  "name": "AIOutputLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "output_type": {
      "type": "string",
      "title": "Output Type",
      "enum": [
        "meeting_minutes",
        "governance_doc",
        "decision_draft",
        "policy_scenario",
        "institutional_memory",
        "summary",
        "other"
      ],
      "default": "other"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "model_used": {
      "type": "string",
      "title": "Model Used"
    },
    "prompt_summary": {
      "type": "string",
      "title": "Prompt Summary"
    },
    "output_summary": {
      "type": "string",
      "title": "Output Summary (plain text \u2014 no HTML/Markdown)"
    },
    "structured_content": {
      "type": "string",
      "title": "Structured Content (JSON-serialized sections)",
      "description": "Safe structured JSON \u2014 array of section objects with title, summary, source_references, evidence_status, confidence. Never HTML or raw Markdown."
    },
    "output_url": {
      "type": "string",
      "title": "Output URL",
      "format": "uri"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At",
      "format": "date-time"
    },
    "generated_by_user_id": {
      "type": "string",
      "title": "Generated By User ID"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By Name"
    },
    "human_reviewed": {
      "type": "boolean",
      "title": "Human Reviewed",
      "default": false
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By Name"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes"
    },
    "approved": {
      "type": "boolean",
      "title": "Approved",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "generated",
        "under_review",
        "approved",
        "rejected",
        "amended"
      ],
      "default": "generated"
    }
  },
  "required": [
    "output_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}