{
  "name": "AIOutputLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "output_type": {
      "type": "string",
      "title": "Output Type"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Entity ID"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title"
    },
    "source_title_en": {
      "type": "string",
      "title": "Source Title (English)"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "model_used": {
      "type": "string",
      "title": "Model Used"
    },
    "prompt_summary": {
      "type": "string",
      "title": "Prompt Summary"
    },
    "prompt_summary_en": {
      "type": "string",
      "title": "Prompt Summary (English)"
    },
    "output_summary": {
      "type": "string",
      "title": "Output Summary (plain text \u2014 no HTML/Markdown)"
    },
    "output_summary_en": {
      "type": "string",
      "title": "Output Summary (English)"
    },
    "structured_content": {
      "type": "string",
      "title": "Structured Content (JSON-serialized sections)"
    },
    "output_url": {
      "type": "string",
      "title": "Output URL"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At"
    },
    "generated_by_user_id": {
      "type": "string",
      "title": "Generated By User ID"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By Name"
    },
    "generated_by_name_en": {
      "type": "string",
      "title": "Generated By Name (English)"
    },
    "human_reviewed": {
      "type": "boolean",
      "title": "Human Reviewed"
    },
    "reviewed_by_name": {
      "type": "string",
      "title": "Reviewed By Name"
    },
    "reviewed_by_name_en": {
      "type": "string",
      "title": "Reviewed By Name (English)"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes"
    },
    "review_notes_en": {
      "type": "string",
      "title": "Review Notes (English)"
    },
    "approved": {
      "type": "boolean",
      "title": "Approved"
    },
    "status": {
      "type": "string",
      "title": "Status"
    }
  },
  "required": [
    "output_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}