{
  "name": "CommitteeMembership",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "committee_id": {
      "type": "string",
      "title": "Committee ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_email": {
      "type": "string",
      "title": "User Email",
      "format": "email"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name (English)"
    },
    "full_name_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "post_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0635\u0628 \u0627\u0644\u0645\u0624\u0633\u0633\u064a"
    },
    "post_en": {
      "type": "string",
      "title": "Institutional Post (English)"
    },
    "role": {
      "type": "string",
      "title": "Committee Role",
      "enum": [
        "chair",
        "vice_chair",
        "secretary",
        "committee_administrator",
        "member",
        "alternate",
        "observer",
        "advisor"
      ],
      "default": "member"
    },
    "authority_level": {
      "type": "string",
      "title": "Authority Level",
      "enum": [
        "decision",
        "approval",
        "execution",
        "oversight",
        "escalation",
        "advisory"
      ],
      "default": "decision"
    },
    "represented_organization_id": {
      "type": "string",
      "title": "Represented Organization ID (the entity this member represents)"
    },
    "membership_type": {
      "type": "string",
      "title": "Membership Type",
      "enum": [
        "internal",
        "represented",
        "external"
      ],
      "default": "internal"
    },
    "is_external_membership": {
      "type": "boolean",
      "title": "External Membership",
      "default": false
    },
    "is_demonstration_role": {
      "type": "boolean",
      "title": "Demonstration Role (synthetic)",
      "default": false
    },
    "voting_right": {
      "type": "boolean",
      "title": "Voting Right",
      "default": true
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "recused",
        "resigned",
        "pending"
      ],
      "default": "active"
    },
    "activated": {
      "type": "boolean",
      "title": "Alternate Activated",
      "default": false
    },
    "term_start": {
      "type": "string",
      "title": "Term Start",
      "format": "date"
    },
    "term_end": {
      "type": "string",
      "title": "Term End",
      "format": "date"
    },
    "end_reason": {
      "type": "string",
      "title": "End Reason (non-destructive)"
    },
    "end_source_instrument_ref": {
      "type": "string",
      "title": "End Source Instrument Reference"
    },
    "end_source_instrument_id": {
      "type": "string",
      "title": "End Source Instrument ID"
    },
    "ended_at": {
      "type": "string",
      "title": "Ended At",
      "format": "date-time"
    },
    "institution_name": {
      "type": "string",
      "title": "Representing Institution"
    },
    "institution_name_en": {
      "type": "string",
      "title": "Representing Institution (English)"
    },
    "protocol_order": {
      "type": "number",
      "title": "Protocol Order",
      "default": 99
    },
    "is_demo_data": {
      "type": "boolean",
      "title": "Is Demo Data",
      "default": false
    },
    "demo_dataset": {
      "type": "string",
      "title": "Demo Dataset Key"
    }
  },
  "required": [
    "organization_id",
    "committee_id",
    "full_name",
    "role",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.active_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}