{
  "name": "Auto Meeting Minutes",
  "description": "When a meeting is marked completed, automatically generate a draft minutes document from the agenda items, decisions, and attendance",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Meeting",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_meeting_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_minutes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "GenerateMeetingMinutes",
            "args": {
              "meeting_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0648\u0644\u064a\u062f \u0645\u0633\u0648\u062f\u0629 \u0627\u0644\u0645\u062d\u0636\u0631",
            "description": "\u0625\u0646\u0634\u0627\u0621 \u0645\u062d\u0636\u0631 \u0627\u062c\u062a\u0645\u0627\u0639 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0645\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
          }
        }
      }
    ]
  }
}