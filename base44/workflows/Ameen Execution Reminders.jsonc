{
  "name": "Ameen Execution Reminders",
  "description": "\u064a\u0646\u0641\u0651\u0630 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u0622\u0644\u064a \u0639\u0628\u0631 \u00ab\u0623\u0645\u064a\u0646\u00bb: \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0628\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0642\u0628\u0644 \u0627\u0642\u062a\u0631\u0627\u0628\u0647\u0627\u060c \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0627\u062a \u0648\u062a\u0635\u0639\u064a\u062f\u0647\u0627 \u0648\u0641\u0642 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u060c \u0648\u0625\u0635\u062f\u0627\u0631 \u0645\u0648\u062c\u0632 \u062a\u0646\u0641\u064a\u0630\u064a \u064a\u0648\u0645\u064a \u0639\u0646 \u062d\u0627\u0644\u0629 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u0629 \u0641\u064a \u0627\u0644\u0644\u062c\u0646\u0629.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Asia/Qatar",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ameen_execution_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "raise_deadline_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "RunExecutionReminders",
            "args": {
              "window_days": 7
            }
          },
          "then": "publish_ameen_followup",
          "x-base44": {
            "title": "\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645",
            "description": "\u0627\u0642\u062a\u0631\u0627\u0628 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0648\u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u0635\u0639\u064a\u062f \u0627\u0644\u0622\u0644\u064a"
          }
        }
      },
      {
        "publish_ameen_followup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "RunAmeenExecutionFollowUp",
            "args": {
              "window_days": 7
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0645\u0648\u062c\u0632 \u0623\u0645\u064a\u0646 \u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
            "description": "\u062d\u0627\u0644\u0629 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0627\u062e\u062a\u0646\u0627\u0642\u0627\u062a"
          }
        }
      }
    ]
  }
}